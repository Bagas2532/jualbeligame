PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/gearvault
JWT_SECRET=change_this_to_a_long_random_string
# 32-byte key, base64-encoded, used for AES-256-GCM encryption of account credentials
ACCOUNT_SECRET_KEY_BASE64=REPLACE_WITH_openssl_rand_base64_32
# Payment gateway (example: Midtrans)
PAYMENT_GATEWAY_SERVER_KEY=REPLACE_ME
PAYMENT_GATEWAY_WEBHOOK_SECRET=REPLACE_ME
PLATFORM_FEE_PERCENT=5
